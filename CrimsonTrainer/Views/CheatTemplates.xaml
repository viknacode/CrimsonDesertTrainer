<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:CrimsonTrainer.ViewModels">

    <!-- Hotkey chip without label (row headers) -->
    <DataTemplate x:Key="HotkeyChipTemplate" DataType="{x:Type vm:HotkeyBindingViewModel}">
        <Button Style="{StaticResource HotkeyChip}" Command="{Binding CaptureCommand}" Content="{Binding Text}" VerticalAlignment="Center"/>
    </DataTemplate>

    <!-- Hotkey chip with its label (extra actions, keep-full toggles) -->
    <DataTemplate x:Key="LabeledHotkeyTemplate" DataType="{x:Type vm:HotkeyBindingViewModel}">
        <StackPanel Orientation="Horizontal" Margin="0,10,18,0">
            <TextBlock Text="{Binding Label}" Style="{StaticResource Small}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Button Style="{StaticResource HotkeyChip}" Command="{Binding CaptureCommand}" Content="{Binding Text}"/>
        </StackPanel>
    </DataTemplate>

    <!-- Editable value: label · text box · Apply -->
    <DataTemplate x:Key="ValueFieldTemplate" DataType="{x:Type vm:ValueFieldViewModel}">
        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{Binding Label}" Style="{StaticResource Body}" VerticalAlignment="Center" Foreground="{StaticResource Text}" FontSize="12.5"/>
            <TextBox Grid.Column="1" Style="{StaticResource MonoTextBox}" Width="180"
                     Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEnabled}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding ApplyCommand}"/>
                </TextBox.InputBindings>
            </TextBox>
            <Button Grid.Column="2" Style="{StaticResource SmallButton}" Content="Apply" Command="{Binding ApplyCommand}" Margin="8,0,0,0" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Small}" Margin="0,4,0,0"
                       Text="{Binding Hint}" Visibility="{Binding Hint, Converter={StaticResource NotEmptyToVisibility}}"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Small}" Margin="0,4,0,0"
                       Foreground="{StaticResource Danger}" Text="{Binding Error}" Visibility="{Binding Error, Converter={StaticResource NotEmptyToVisibility}}"/>
        </Grid>
    </DataTemplate>

    <!-- Shared body of a cheat card: description, how-to, warnings, fields, extra hotkeys -->
    <DataTemplate x:Key="CheatDetailsTemplate">
        <StackPanel>
            <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0" Text="{Binding Description}"
                       Visibility="{Binding Description, Converter={StaticResource NotEmptyToVisibility}}"/>

            <Grid Margin="0,6,0,0" Visibility="{Binding HowTo, Converter={StaticResource NotEmptyToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock FontFamily="{StaticResource IconFont}" FontSize="11" Text="&#xE7C1;" Foreground="{StaticResource Info}" Margin="0,3,8,0"/>
                <TextBlock Grid.Column="1" Style="{StaticResource Small}" Foreground="{StaticResource Muted}" Text="{Binding HowTo}"/>
            </Grid>

            <Border Style="{StaticResource WarningBanner}" Visibility="{Binding Warning, Converter={StaticResource NotEmptyToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource Warning}" Text="&#xE7BA;" Margin="0,1,10,0"/>
                    <TextBlock Grid.Column="1" TextWrapping="Wrap" Foreground="{StaticResource Warning}" FontSize="12.5" Text="{Binding Warning}"/>
                </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding Fields}" ItemTemplate="{StaticResource ValueFieldTemplate}"/>

            <!-- Extra hotkeys (anything beyond the first binding) -->
            <ItemsControl ItemsSource="{Binding Bindings}" ItemTemplate="{StaticResource LabeledHotkeyTemplate}"
                          AlternationCount="1000">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Style.Triggers>
                            <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>

            <TextBlock Style="{StaticResource Small}" Margin="0,8,0,0" Foreground="{StaticResource Faint}"
                       Text="{Binding UnavailableReason}" Visibility="{Binding IsAvailable, Converter={StaticResource InverseBoolToVisibility}}"/>

            <TextBlock Style="{StaticResource Small}" Margin="0,6,0,0" Foreground="{StaticResource Faint}" FontSize="11"
                       Visibility="{Binding Credits, Converter={StaticResource NotEmptyToVisibility}}">
                <Run Text="Credits: "/><Run Text="{Binding Credits, Mode=OneWay}"/>
            </TextBlock>
        </StackPanel>
    </DataTemplate>

    <!-- On/off cheat -->
    <DataTemplate DataType="{x:Type vm:ToggleCheatViewModel}">
        <Border Style="{StaticResource Card}">
            <Border.Resources>
                <Style TargetType="Border" x:Key="Dim">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                            <Setter Property="Opacity" Value="0.6"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Resources>
            <Border Style="{StaticResource Dim}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Name}" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Style="{StaticResource ActiveChip}" Margin="10,0,0,0">
                            <TextBlock Style="{StaticResource ChipText}" Foreground="{StaticResource Success}" Text="ACTIVE"/>
                        </Border>
                        <ContentControl Grid.Column="2" Content="{Binding Bindings[0]}" ContentTemplate="{StaticResource HotkeyChipTemplate}" Margin="12,0,0,0"/>
                        <CheckBox Grid.Column="3" Style="{StaticResource ToggleSwitch}" Margin="14,0,0,0"
                                  IsChecked="{Binding IsOn}" IsEnabled="{Binding CanInteract}"/>
                    </Grid>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CheatDetailsTemplate}"/>
                </StackPanel>
            </Border>
        </Border>
    </DataTemplate>

    <!-- Cheat with variants -->
    <DataTemplate DataType="{x:Type vm:ChoiceCheatViewModel}">
        <Border Style="{StaticResource Card}">
            <Border.Resources>
                <Style TargetType="Border" x:Key="Dim">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                            <Setter Property="Opacity" Value="0.6"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Resources>
            <Border Style="{StaticResource Dim}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Name}" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Style="{StaticResource ActiveChip}" Margin="10,0,0,0">
                            <TextBlock Style="{StaticResource ChipText}" Foreground="{StaticResource Success}" Text="{Binding Selected.Label}"/>
                        </Border>
                        <ContentControl Grid.Column="2" Content="{Binding Bindings[0]}" ContentTemplate="{StaticResource HotkeyChipTemplate}" Margin="12,0,0,0"/>
                    </Grid>

                    <Border Margin="0,12,0,0" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                            CornerRadius="11" Padding="2" HorizontalAlignment="Left" IsEnabled="{Binding CanInteract}">
                        <ItemsControl ItemsSource="{Binding Options}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ChoiceOptionViewModel}">
                                    <RadioButton Content="{Binding Label}" IsChecked="{Binding IsSelected}" MinWidth="92">
                                        <RadioButton.Style>
                                            <Style TargetType="RadioButton" BasedOn="{StaticResource Segment}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOff}" Value="True">
                                                        <Setter Property="Template" Value="{StaticResource SegmentNeutralTemplate}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </RadioButton.Style>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <Border Style="{StaticResource WarningBanner}" Visibility="{Binding SelectedWarning, Converter={StaticResource NotEmptyToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource Warning}" Text="&#xE7BA;" Margin="0,1,10,0"/>
                            <TextBlock Grid.Column="1" TextWrapping="Wrap" Foreground="{StaticResource Warning}" FontSize="12.5" Text="{Binding SelectedWarning}"/>
                        </Grid>
                    </Border>

                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CheatDetailsTemplate}"/>
                </StackPanel>
            </Border>
        </Border>
    </DataTemplate>

    <!-- Activity log line -->
    <DataTemplate DataType="{x:Type vm:LogEntry}">
        <Grid Margin="0,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding TimeText}" Style="{StaticResource Mono}" Foreground="{StaticResource Faint}" Margin="0,0,14,0"/>
            <TextBlock Grid.Column="1" Text="{Binding Message}" FontSize="12.5" Style="{StaticResource LogText}"/>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
